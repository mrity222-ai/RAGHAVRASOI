# SQLite default for instant zero-dependency local run
DATABASE_URL="file:./dev.db"

# To switch to PostgreSQL:
# 1. In prisma/schema.prisma, change: provider = "postgresql"
# 2. Uncomment below and update with your credentials:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ranel_restaurant?schema=public"

# To switch to MySQL:
# 1. In prisma/schema.prisma, change: provider = "mysql"
# 2. Uncomment below and update with your credentials:
# DATABASE_URL="mysql://root:password@localhost:3306/ranel_restaurant"
