# =======================================================
# Raghav Rasoi (raghavrasoi.com) Environment Variables
# =======================================================

# 1. Hostinger MySQL Database URL
# Format: mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>
# Example: mysql://u123456789_admin:YourStrongPassword123@127.0.0.1:3306/u123456789_raghav
DATABASE_URL="mysql://u123456789_admin:YourPassword@127.0.0.1:3306/u123456789_raghav"

# 2. Official Production Domain
NEXT_PUBLIC_APP_URL="https://raghavrasoi.com"
NEXT_PUBLIC_BASE_URL="https://raghavrasoi.com"

# 3. Online Payment Gateway (Optional - for UPI / Cards)
# Create account at https://razorpay.com or https://phonepe.com
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"

# 4. SMS OTP Gateway (Optional - for real mobile OTP delivery)
# Create account at https://www.fast2sms.com (India Quick SMS Route)
FAST2SMS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
